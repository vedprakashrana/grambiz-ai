# Environment Configuration for GramBiz AI

# Application
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL with PostGIS and pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grambiz_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/grambiz_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grambiz_db

# Cache
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=super-secret-grambiz-jwt-key-change-in-prod-1234567890
JWT_REFRESH_SECRET=super-secret-grambiz-jwt-refresh-key-change-in-prod-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Providers (Options: mock, openai, gemini, anthropic)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="GramBiz AI"
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
