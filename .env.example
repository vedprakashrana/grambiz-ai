# Environment Configuration for GramBiz AI

# Application
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL & MongoDB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grambiz_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/grambiz_db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=grambiz_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grambiz_db

# Multilingual AI (Bhashini / IndicTrans2)
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Cache
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=super-secret-grambiz-jwt-key-change-in-prod-1234567890
JWT_REFRESH_SECRET=super-secret-grambiz-jwt-refresh-key-change-in-prod-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Providers (Options: mock, openai, gemini, anthropic)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="GramBiz AI"
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
